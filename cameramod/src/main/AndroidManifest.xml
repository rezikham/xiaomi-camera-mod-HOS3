<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:description="@string/module_description"
        android:label="@string/app_name"
        tools:ignore="MissingApplicationIcon">

        <!-- Main settings activity - has INFO for Vector/LSPosed settings access (matches reference) -->
        <activity
            android:name=".SettingsActivity"
            android:label="@string/settings_title"
            android:exported="true"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity>

        <!-- Launcher alias - THIS is the LAUNCHER entry point (can be disabled to hide icon) -->
        <!-- Also has INFO category so Vector/LSPosed can use it when enabled, falls back to SettingsActivity when disabled -->
        <activity-alias
            android:name=".LauncherAlias"
            android:label="@string/app_name"
            android:exported="true"
            android:targetActivity=".SettingsActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>