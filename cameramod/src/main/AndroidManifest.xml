<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:description="@string/module_description"
        android:label="@string/app_name"
        tools:ignore="MissingApplicationIcon">

        <!-- Main settings activity - no LAUNCHER category, so Vector/LSPosed can still open it -->
        <activity
            android:name=".SettingsActivity"
            android:label="@string/settings_title"
            android:exported="true"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Separate launcher activity - can be disabled to hide app icon without affecting SettingsActivity -->
        <activity
            android:name=".LauncherActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>