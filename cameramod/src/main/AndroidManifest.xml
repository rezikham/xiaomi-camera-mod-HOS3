<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:description="@string/module_description"
        android:label="@string/app_name"
        tools:ignore="MissingApplicationIcon">

        <!-- Main settings activity - always accessible for Vector/LSPosed -->
        <activity
            android:name=".SettingsActivity"
            android:label="@string/settings_title"
            android:exported="true"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.PREFERENCE" />
            </intent-filter>
        </activity>

        <!-- Launcher alias - can be disabled to hide app icon without affecting SettingsActivity -->
        <activity-alias
            android:name=".LauncherAlias"
            android:label="@string/app_name"
            android:exported="true"
            android:targetActivity=".SettingsActivity"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>