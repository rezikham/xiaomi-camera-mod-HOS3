# HyperCameraMod SELinux policy -- LUT-ONLY TEST BUILD

# Allow the module script to write/stage LUT files in /data/vendor/camera
allow kernelsu kernelsu_data_file:dir { write add_name remove_name }
allow kernelsu kernelsu_data_file:file { write create unlink }

# Allow camera HAL to read the staged LUTs
allow hal_camera_default vendor_camera_data_file:file { read open getattr }

# Allow chcon of the staged LUTs
allow kernelsu file_type:security compute_av

# Allow the engine gate property write
allow kernelsu property_socket:unix_stream_socket connectto
allow kernelsu camera_prop:property_service set

# Allow the camera app (platform_app) to read the staged LUTs for live preview
allow platform_app vendor_data_file:dir search;
allow platform_app vendor_camera_data_file:dir { search read open getattr };
allow platform_app vendor_camera_data_file:file { read open getattr map };
